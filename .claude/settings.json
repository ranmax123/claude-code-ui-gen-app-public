{
  "env": {
    "PATH": "C:\\Program Files\\nodejs;%PATH%"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
             "type": "command",
            "command": "node ./hooks/read_hook.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/format_hook.js"
          }
        ]
      }
    ]
  }
}